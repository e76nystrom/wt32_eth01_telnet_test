{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "server",
      "displayName": "Server",
      "binaryDir": "${sourceDir}/build_server",
      "cacheVariables": {
        "BUILD_TARGET": "SERVER"
      }
    },
    {
      "name": "client",
      "displayName": "Client",
      "binaryDir": "${sourceDir}/build_client",
      "cacheVariables": {
        "BUILD_TARGET": "CLIENT"
      }
    }
  ]
}
